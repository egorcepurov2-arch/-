#!/bin/sh
# Git pre-commit hook to verify application health and schema validity
set -e

echo "🔍 [PRE-COMMIT] Запуск проверки работоспособности перед коммитом..."

# 1. Run unit tests
python3 -m unittest discover tests -v

# 2. Run stream validation
python3 tests/validate_stream.py

echo "✅ [PRE-COMMIT] Все тесты пройдены! Коммит разрешён."
